{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 6,
  "height": 32,
  "modules-left": ["custom/appmenu", "hyprland/workspaces"],
  "modules-center": ["clock", "custom/screenrecording-indicator"],
  "modules-right": [
    "custom/pacman",
    "tray",
    "group/connectivity",
    "group/controls",
    "group/power-status",
    "cpu",
    "custom/power"
  ],
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "network"]
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "backlight"]
  },
  "group/power-status": {
    "orientation": "horizontal",
    "modules": ["battery", "custom/power-profile"]
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "lock": "loginctl lock-session",
      "logout": "uwsm stop",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate",
      "reboot": "systemctl reboot",
      "shutdown": "systemctl poweroff"
    }
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "Brightness: {percent}%",
    "scroll-step": 5
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "cpu": {
    "interval": 10,
    "format": "󰍛",
    "on-click": "$HOME/.local/bin/hyprland-launch-or-focus-tui btop",
    "on-click-right": "uwsm-app -- ghostty"
  },
  "clock": {
    "format": "󰥔  {:L%A  %H:%M}",
    "format-alt": "󰃭  {:L%d %B · W%V · %Y}",
    "tooltip": false
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "align": 0.5,
    "justify": "center",
    "interval": 5,
    "spacing": 1,
    "on-click": "$HOME/.local/bin/hyprland-launch-wifi"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅 {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "custom/power-profile": {
    "exec": "$HOME/.local/bin/hyprland-power-profile",
    "return-type": "json",
    "interval": 10,
    "signal": 10,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_profile_menu.xml",
    "menu-actions": {
      "performance": "powerprofilesctl set performance && pkill -RTMIN+10 -x waybar",
      "balanced": "powerprofilesctl set balanced && pkill -RTMIN+10 -x waybar",
      "power-saver": "powerprofilesctl set power-saver && pkill -RTMIN+10 -x waybar"
    },
    "tooltip": true
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "$HOME/.local/bin/hyprland-launch-bluetooth"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "$HOME/.local/bin/hyprland-launch-or-focus-tui wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "custom/screenrecording-indicator": {
    "on-click": "$HOME/.local/bin/hyprland-screenrecord",
    "exec": "$HOME/.config/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "custom/appmenu": {
    "on-click-right": "~/.local/bin/hyprland-launch-keybinds",
    "tooltip-format": "Clic: abrir aplicaciones\nClic derecho: ver atajos",
    "on-click": "uwsm-app -- rofi -show drun",
    "format": "󰣇"
  },
  "custom/pacman": {
    "format": "{text}",
    "return-type": "json",
    "align": 0.5,
    "justify": "center",
    "exec": "$HOME/.local/bin/hyprland-check-updates",
    "interval": 1800,
    "signal": 9,
    "on-click": "$HOME/.local/bin/hyprland-launch-updates"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
