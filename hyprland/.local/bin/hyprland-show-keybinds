#!/bin/bash

# Show Hyprland keybindings using fzf

hyprctl -j binds | \
    jq -r '
        def hasmod($bit): ((.modmask / $bit | floor) % 2) == 1;
        def mods: [
            if hasmod(64) then "SUPER" else empty end,
            if hasmod(4) then "CTRL" else empty end,
            if hasmod(1) then "SHIFT" else empty end,
            if hasmod(8) then "ALT" else empty end
        ];

        .[]
        | select(.description != "")
        | ((mods + [(.key // ("code:" + (.keycode | tostring)))]) | join(" + ")) as $keys
        | "\($keys)  |  \(.description)"
    ' | \
    fzf --ansi \
        --header="Hyprland Keybindings (ESC to close)" \
        --header-first \
        --layout=reverse \
        --border=rounded \
        --margin=1 \
        --padding=1 \
        --no-info \
        --bind 'enter:abort'
