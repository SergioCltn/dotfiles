#!/usr/bin/env bash

profile=$(powerprofilesctl get 2>/dev/null || true)

case "$profile" in
    performance) icon="" ;;
    balanced) icon="" ;;
    power-saver) icon="" ;;
    *)
        printf '%s\n' '{"text":"?","tooltip":"Power profiles daemon unavailable","class":"error"}'
        exit 0
        ;;
esac

printf '{"text":"%s","tooltip":"Profile: %s\\nClick to choose another profile","class":"%s"}\n' \
    "$icon" "$profile" "$profile"
