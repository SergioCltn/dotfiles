#!/usr/bin/env bash

set -u

if ! command -v powerprofilesctl >/dev/null 2>&1 || ! command -v hyprlauncher >/dev/null 2>&1; then
    notify-send -u critical "Power profiles" "Falta powerprofilesctl o hyprlauncher" 2>/dev/null || true
    exit 1
fi

selected=$(printf '%s\n' performance balanced power-saver | hyprlauncher --dmenu)

case "$selected" in
    performance|balanced|power-saver)
        if powerprofilesctl set "$selected"; then
            pkill -RTMIN+10 -x waybar 2>/dev/null || true
        else
            notify-send -u critical "Power profiles" "No se pudo activar: $selected" 2>/dev/null || true
            exit 1
        fi
        ;;
esac
