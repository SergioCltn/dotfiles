; Overrides for the Silent SDDM theme (configs/default.conf).
; Installed into the silent-minimal theme copy by install/login/sddm.sh.
; Minimal: blurred wallpaper, only a password field with a cursor; Enter logs in.

[General]
background-fill-mode = "fill"

[LockScreen]
display = false
background = "dotfiles-wallpaper.jpg"
blur = 64
brightness = -0.5

[LoginScreen]
background = "dotfiles-wallpaper.jpg"
blur = 64
brightness = -0.5

; The theme always draws an avatar; shrink it to 1px to hide it.
[LoginScreen.LoginArea.Avatar]
active-size = 1
inactive-size = 1
active-border-size = 0
inactive-border-size = 0

; Same for the username: transparent and 1px so it takes no space.
[LoginScreen.LoginArea.Username]
font-size = 1
color = "#00000000"
margin = 0

[LoginScreen.LoginArea.PasswordInput]
width = 240
height = 40
display-icon = false
font-family = "Inter"
font-size = 12
content-color = "#F2F2F2"
background-color = "#FFFFFF"
background-opacity = 0.08
border-size = 0
border-radius-left = 20
border-radius-right = 20
margin-top = 16

[LoginScreen.LoginArea.LoginButton]
hide-if-not-needed = true
background-color = "#FFFFFF"
background-opacity = 0.08
active-background-color = "#FFFFFF"
active-background-opacity = 0.16
border-size = 0
border-radius-left = 20
border-radius-right = 20
font-family = "Inter"

[LoginScreen.LoginArea.Spinner]
display-text = false
color = "#33CCFF"

[LoginScreen.LoginArea.WarningMessage]
font-family = "Inter"
normal-color = "#B3B3B3"
warning-color = "#B3B3B3"
error-color = "#F38BA8"

[LoginScreen.MenuArea.Buttons]
margin-right = 32
margin-bottom = 32
font-family = "Inter"

[LoginScreen.MenuArea.Popups]
background-color = "#1A1A1A"
background-opacity = 0.75
active-option-background-color = "#FFFFFF"
active-option-background-opacity = 0.12
font-family = "Inter"

[LoginScreen.MenuArea.Session]
display = false

[LoginScreen.MenuArea.Layout]
display = false

[LoginScreen.MenuArea.Keyboard]
display = false

[LoginScreen.MenuArea.Power]
popup-direction = "up"
popup-align = "end"
content-color = "#808080"
active-content-color = "#F2F2F2"
active-background-opacity = 0.0

[Tooltips]
enable = false
